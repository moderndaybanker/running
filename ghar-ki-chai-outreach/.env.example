# Copy this file to .env and fill in values as needed.

# Search provider options: mock, serpapi, tavily
SEARCH_PROVIDER=mock

# Optional API keys. Only required when using the matching provider.
SERPAPI_API_KEY=your_serpapi_key_here
TAVILY_API_KEY=your_tavily_key_here

# Polite scraping defaults
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_SECONDS=2
USER_AGENT=GharKiChaiOutreachBot/0.1 (+https://gharkichai.example)

# Output defaults
LOG_LEVEL=INFO
